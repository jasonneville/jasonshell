{
  "name": "jasonShell",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:node": "node scripts/clean-dist-tests.mjs && tsc -p tsconfig.test.json && node --test tests/*.test.mjs",
    "test:component": "vitest run --config vitest.config.ts",
    "test:search": "npm run test:node",
    "p03:experiment": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/stack-text-editor/launch-p03-experiment.ps1",
    "cargo:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "cargo:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "smoke:runtime": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/runtime-smoke.ps1 -DryRun",
    "smoke:fullscreen": "powershell -ExecutionPolicy Bypass -File scripts/smoke-fullscreen-appbar.ps1",
    "validate": "npm run check && npm run build && npm run test:component && npm run test:node && npm run cargo:test && npm run cargo:check",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "afplay": "^1.0.4",
    "bun": "^1.3.13",
    "bunx": "^0.1.0",
    "melt": "^0.44.0",
    "osascript": "^1.2.0"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@lezer/highlight": "1.2.3",
    "@replit/codemirror-lang-svelte": "6.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "2.10",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.1",
    "@tsconfig/svelte": "^5.0.0",
    "@types/node": "^24.0.0",
    "codemirror": "6.0.2",
    "jsdom": "27.4.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vite-plugin-terminal": "^1.4.0",
    "vitest": "4.1.11"
  }
}
