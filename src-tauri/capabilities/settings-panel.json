{
  "identifier": "settings-panel",
  "description": "Settings dropdown auxiliary surface capability: renderer-only shell preferences and theme/font/date controls.",
  "windows": [
    "settings-panel"
  ],
  "permissions": [
    "core:default",
    "core:window:default",
    "allow-get-standard-hotkey-status",
    "allow-save-standard-hotkeys",
    "allow-begin-standard-hotkey-capture",
    "allow-renew-standard-hotkey-capture",
    "allow-end-standard-hotkey-capture"
  ]
}
